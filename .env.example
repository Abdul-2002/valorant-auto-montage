# Copy to `.env` and fill values. Never commit `.env`.

STORAGE_DIR=./data
REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_BACKEND_URL=redis://localhost:6379/1
MONTAGE_CONFIG_PATH=config/default.yaml

# Optional Gemini features
GEMINI_API_KEY=

# Roboflow Universe dataset download (training/scripts/download_roboflow_raw.py)
ROBOFLOW_API_KEY=

# YouTube upload (optional). Prefer env vars for Docker;
# or place a gitignored client_secret*.json in the project root for local runs.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/youtube/callback

# Optional OpenAI-compatible / local LLM
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
