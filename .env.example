# Copy this file to `.env` and fill values.
#
# The docker-compose file auto-loads `.env` and can pass selected variables into
# containers. Local `uvicorn` / `celery` runs will also pick these up.

# Storage for task artifacts (highlights, scripts, outputs)
STORAGE_DIR=./data

# Celery broker/result backend
REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_BACKEND_URL=redis://localhost:6379/1

# Config path (defaults to config/default.yaml)
MONTAGE_CONFIG_PATH=config/default.yaml

# Gemini provider (optional). Also used once per new source video to write the library summary.
GEMINI_API_KEY=

# YouTube Data API OAuth client. Leave these blank to use a Desktop client JSON
# downloaded from Google Cloud (client_secret*.json in the project root).
# Tokens are stored in STORAGE_DIR/library.sqlite3, not in this file.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/youtube/callback

# OpenAI-compatible provider (optional)
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
