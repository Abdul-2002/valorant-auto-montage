songs/*
!songs/.gitkeep
outputs/*
!outputs/.gitkeep

# frontend (Vite / Node)
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.local

# gameplay / montage / audio media (never commit)
*.mp4
*.mkv
*.webm
*.mov
*.avi
*.m4v
*.DVR.mp4
*.mp3
*.wav
*.flac
*.ogg
*.info.json

# model weights (download separately)
*.pt
models/*
!models/.gitkeep

# OS / IDE
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
# Keep .cursor/rules; ignore personal Cursor notes in the folder root
.cursor/*.md
