venv/
.env
client_secret*.json
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage/
*.cover

# runtime / local data (never commit)
data/
library.sqlite3
artifacts/
runs/
tmp/
*.log
codebase_dump.txt
