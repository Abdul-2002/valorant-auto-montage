songs/*
!songs/.gitkeep
outputs/*
!outputs/.gitkeep

# frontend (Vite / Node)
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.local

# gameplay / montage / audio media (never commit)
*.mp4
*.mkv
*.webm
*.mov
*.avi
*.m4v
*.DVR.mp4
*.mp3
*.wav
*.flac
*.ogg
*.info.json

# model weights (download separately)
*.pt
models/*
!models/.gitkeep

# local YOLO fine-tune data + runs (keep scaffolding via .gitkeep / docs)
training/datasets/**/images/**
training/datasets/**/labels/**
training/datasets/raw/**
!training/datasets/**/.gitkeep
!training/datasets/**/images/**/.gitkeep
!training/datasets/**/labels/**/.gitkeep
!training/datasets/raw/**/.gitkeep
!training/datasets/raw/**/*.md
!training/datasets/raw/SOURCES.md
training/runs/
training/weights/*.pt

